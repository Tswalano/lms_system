{
  "name": "lms-backend",
  "version": "0.1.0",
  "bin": {
    "lms-backend": "bin/lms-backend.js"
  },
  "scripts": {
    "watch": "tsc -w",
    "cdk": "cdk",
    "clean": "rm -f lambda/*.js lambda/*.js.map lambda/*.d.ts ",
    "build": "tsc && npm run copy-lambda",
    "copy-lambda": "cp -r lambda/*.js lambda/*.json dist/lambda/ || true"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.2",
    "aws-cdk": "2.1019.0",
    "esbuild": "^0.25.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-nodejs": "^1.203.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.840.0",
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/client-secrets-manager": "^3.840.0",
    "@aws-sdk/client-ses": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.842.0",
    "aws-cdk-lib": "2.201.0",
    "constructs": "^10.0.0",
    "dayjs": "^1.11.13",
    "hono": "^4.8.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "zod": "^3.25.71"
  }
}
