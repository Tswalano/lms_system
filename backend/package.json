{
  "name": "lms-backend",
  "version": "0.1.0",
  "bin": {
    "lms-backend": "bin/lms-backend.js"
  },
  "scripts": {
    "watch": "tsc -w",
    "cdk": "cdk",
    "clean": "rm -f lambda/*.js lambda/*.js.map lambda/*.d.ts ",
    "build": "tsc && npm run copy-lambda",
    "dev": "ts-node lambda/dev.ts",
    "dev:watch": "nodemon lambda/dev.ts",
    "dev:all": "concurrently --names \"API,DOCS\" --prefix-colors \"blue,green\" \"npm run dev:watch\" \"npm run dev --prefix ../api-docs\"",
    "docs:build": "npm run build --prefix ../api-docs",
    "copy-lambda": "find lambda/ -type f \\( -name \"*.js\" -o -name \"*.json\" \\) -exec cp --parents {} dist/ \\;"
  },
  "devDependencies": {
    "@hono/node-server": "^1.18.1",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.17.1",
    "aws-cdk": "2.1019.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.1",
    "esbuild": "^0.25.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.13.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-nodejs": "^1.32.2",
    "@aws-sdk/client-cognito-identity-provider": "^3.840.0",
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/client-secrets-manager": "^3.840.0",
    "@aws-sdk/client-ses": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.842.0",
    "@prisma/client": "^6.13.0",
    "aws-cdk-lib": "2.201.0",
    "constructs": "^10.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "17.2.1",
    "hono": "^4.8.3",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "mysql2": "^3.14.1",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0",
    "vite": "7.0.5",
    "zod": "^3.25.71"
  }
}
