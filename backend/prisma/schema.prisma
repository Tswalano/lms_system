generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id                     String                      @id @default(uuid()) @db.VarChar(36)
  firstName              String?                     @db.VarChar(255)
  lastName               String?                     @db.VarChar(255)
  email                  String?                     @unique @db.VarChar(255)
  role                   String?                     @db.VarChar(255)
  jobTitle               String?                     @db.VarChar(255)
  dob                    DateTime?                   @db.Date
  gender                 String?                     @db.VarChar(255)
  phoneNumber            String?                     @db.VarChar(255)
  employeeId             String?                     @unique @db.VarChar(50)
  departmentId           Int?
  managerId              String?                     @db.VarChar(36)
  roleType               user_role_type?
  jobLevel               String?                     @db.VarChar(50)
  isActive               Boolean                     @default(true)
  createdAt              DateTime                    @default(now()) @db.DateTime(0)
  updatedAt              DateTime                    @default(now()) @db.DateTime(0)
  document_signatures    document_signatures[]
  document_views         document_views[]
  created_documents      documents[]                 @relation("DocumentCreator")
  leave_action_log       leave_action_log[]
  leave_requests         leave_requests[]
  managerFeedback        manager_feedback[]
  createdNotifications   notifications[]             @relation("NotificationCreator")
  notifications          notifications[]             @relation("NotificationRecipient")
  createdReviews         performance_reviews[]       @relation("ReviewCreator")
  reviewsAsEmployee      performance_reviews[]       @relation("EmployeeReviews")
  reviewsAsManager       performance_reviews[]       @relation("ManagerReviews")
  reviewsAsReviewee      performance_reviews[]       @relation("RevieweeReviews")
  responses              review_responses[]
  user_departments       user_departments[]
  document_assignments   user_document_assignments[]
  document_reminders     document_reminders[]
  createdCycles          review_cycles[]             @relation("CycleCreator")
  assignmentsAsReviewee  peer_review_assignments[]   @relation("PeerReviewee")
  assignmentsAsReviewer  peer_review_assignments[]   @relation("PeerReviewer")
  department             departments?                @relation(fields: [departmentId], references: [id])
  manager                users?                      @relation("UserManager", fields: [managerId], references: [id])
  directReports          users[]                     @relation("UserManager")

  @@index([managerId])
  @@index([departmentId])
  @@map("users")
}

model leave_requests {
  id                        BigInt                      @id @default(autoincrement())
  uid                       String                      @db.VarChar(255)
  leave_type                String                      @db.VarChar(255)
  status                    leave_status                @default(pending)
  duration                  Int
  start_date                DateTime                    @db.Date
  end_date                  DateTime                    @db.Date
  feedback                  String?                     @db.Text
  document                  String?                     @db.Text
  leave_length              leave_requests_leave_length
  leave_comment             String?                     @db.Text
  system_notes              String?                     @db.Text
  approved_by               String?                     @db.VarChar(36)
  approved_at               DateTime?                   @db.Timestamp(0)
  createdAt                 DateTime?                   @default(now()) @db.Timestamp(0)
  updatedAt                 DateTime?                   @default(now()) @db.Timestamp(0)
  outlook_shared_event_id   String?                     @db.VarChar(512)
  outlook_personal_event_id String?                     @db.VarChar(512)
  leave_action_log          leave_action_log[]
  approver                  users?                      @relation(fields: [approved_by], references: [id], onUpdate: NoAction, map: "fk_approved_by_user")

  @@index([approved_by], map: "fk_approved_by_user")
  @@index([uid])
  @@map("leave_requests")
}

model leave_action_log {
  id              BigInt         @id @default(autoincrement())
  leave_id        BigInt
  manager_id      String?        @db.VarChar(36)
  action          String         @db.VarChar(255)
  previous_status String?        @db.VarChar(50)
  new_status      String?        @db.VarChar(50)
  timestamp       DateTime?      @default(now()) @db.Timestamp(0)
  leave_request   leave_requests @relation(fields: [leave_id], references: [id], onDelete: Cascade)
  manager         users?         @relation(fields: [manager_id], references: [id])

  @@index([leave_id])
  @@index([manager_id])
  @@map("leave_action_log")
}

model document_categories {
  id           BigInt      @id @default(autoincrement())
  name         String      @db.VarChar(255)
  description  String?     @db.Text
  color        String?     @db.VarChar(50)
  createdAt    DateTime    @default(now()) @db.Timestamp(0)
  updatedAt    DateTime    @default(now()) @db.Timestamp(0)
  departmentId Int
  department   departments @relation(fields: [departmentId], references: [id])
  documents    documents[]

  @@index([departmentId])
  @@map("document_categories")
}

model documents {
  id                BigInt                      @id @default(autoincrement())
  name              String                      @db.VarChar(500)
  category_id       BigInt
  file_url          String                      @db.Text
  file_size         String?                     @db.VarChar(50)
  content           String?                     @db.Text
  priority          document_priority           @default(medium)
  created_by        String?                     @db.VarChar(36)
  createdAt         DateTime                    @default(now()) @db.Timestamp(0)
  updatedAt         DateTime                    @default(now()) @db.Timestamp(0)
  status            documents_status            @default(active)
  signatures        document_signatures[]
  training_metadata document_training_metadata?
  views             document_views[]
  reminders         document_reminders[]
  category          document_categories         @relation(fields: [category_id], references: [id])
  creator           users?                      @relation("DocumentCreator", fields: [created_by], references: [id])
  user_assignments  user_document_assignments[]

  @@index([category_id])
  @@index([created_by])
  @@index([priority])
  @@map("documents")
}

model document_training_metadata {
  document_id           BigInt    @id
  version               String?   @db.VarChar(50)
  renewal_frequency     Int?
  expiry_date           DateTime? @db.DateTime(0)
  is_mandatory          Boolean   @default(false)
  auto_assign_new_users Boolean   @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamp(0)
  updatedAt             DateTime  @default(now()) @db.Timestamp(0)
  document              documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([expiry_date])
  @@index([is_mandatory])
  @@index([auto_assign_new_users])
  @@map("document_training_metadata")
}

model user_document_assignments {
  id           BigInt                     @id @default(autoincrement())
  user_id      String                     @db.VarChar(36)
  document_id  BigInt
  status       document_assignment_status @default(pending)
  due_date     DateTime?                  @db.DateTime(0)
  assigned_at  DateTime                   @default(now()) @db.Timestamp(0)
  completed_at DateTime?                  @db.Timestamp(0)
  document     documents                  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user         users                      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, document_id])
  @@index([user_id])
  @@index([document_id])
  @@index([status])
  @@index([due_date])
  @@map("user_document_assignments")
}

model document_signatures {
  id          BigInt    @id @default(autoincrement())
  user_id     String    @db.VarChar(36)
  document_id BigInt
  signed_at   DateTime  @default(now()) @db.Timestamp(0)
  document    documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, document_id])
  @@index([user_id])
  @@index([document_id])
  @@map("document_signatures")
}

model document_views {
  id            BigInt    @id @default(autoincrement())
  user_id       String    @db.VarChar(36)
  document_id   BigInt
  viewed_at     DateTime  @default(now()) @db.Timestamp(0)
  ip_address    String?   @db.VarChar(45)
  duration      Int?
  progress_data String?   @db.Text
  document      documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user          users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([document_id])
  @@index([viewed_at])
  @@map("document_views")
}

model document_reminders {
  id          BigInt    @id @default(autoincrement())
  user_id     String    @db.VarChar(36)
  document_id BigInt
  sent_at     DateTime  @default(now()) @db.Timestamp(0)
  document    documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([document_id])
  @@index([sent_at])
  @@index([user_id, document_id, sent_at])
  @@map("document_reminders")
}

model departments {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(255)
  description         String?               @db.Text
  createdAt           DateTime              @default(now()) @db.Timestamp(0)
  updatedAt           DateTime              @default(now()) @db.Timestamp(0)
  document_categories document_categories[]
  users               user_departments[]
  employees           users[]

  @@map("departments")
}

model user_departments {
  id            BigInt      @id @default(autoincrement())
  user_id       String      @db.VarChar(36)
  department_id Int
  department    departments @relation(fields: [department_id], references: [id], onDelete: Cascade)
  user          users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, department_id])
  @@index([user_id])
  @@index([department_id])
  @@map("user_departments")
}

model notifications {
  id          BigInt                @id @default(autoincrement())
  recipientId String                @db.VarChar(36)
  createdById String?               @db.VarChar(36)
  type        notification_type
  category    notification_category
  title       String                @db.VarChar(255)
  message     String                @db.Text
  actionUrl   String?               @db.VarChar(500)
  actionText  String?               @db.VarChar(100)
  imageUrl    String?               @db.VarChar(500)
  relatedId   String?               @db.VarChar(36)
  relatedType String?               @db.VarChar(50)
  isRead      Boolean               @default(false)
  isArchived  Boolean               @default(false)
  readAt      DateTime?             @db.Timestamp(0)
  priority    notification_priority @default(normal)
  createdAt   DateTime              @default(now()) @db.Timestamp(0)
  updatedAt   DateTime              @default(now()) @db.Timestamp(0)
  createdBy   users?                @relation("NotificationCreator", fields: [createdById], references: [id])
  recipient   users                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([recipientId, isArchived])
  @@index([type])
  @@index([category])
  @@index([priority])
  @@index([relatedId, relatedType])
  @@index([createdAt])
  @@index([createdById], map: "notifications_createdById_fkey")
  @@map("notifications")
}

model review_cycles {
  id          String               @id @default(uuid()) @db.VarChar(36)
  name        String               @db.VarChar(100)
  startDate   DateTime             @db.Date
  endDate     DateTime             @db.Date
  status      review_cycle_status  @default(draft)
  createdById String?              @db.VarChar(36)
  createdAt   DateTime             @default(now()) @db.Timestamp(0)
  updatedAt   DateTime             @default(now()) @db.Timestamp(0)
  creator     users?               @relation("CycleCreator", fields: [createdById], references: [id])
  reviews     performance_reviews[]
  assignments peer_review_assignments[]

  @@index([status])
  @@index([createdById])
  @@map("review_cycles")
}

model peer_review_assignments {
  id                  String                  @id @default(uuid()) @db.VarChar(36)
  cycleId             String                  @db.VarChar(36)
  revieweeId          String                  @db.VarChar(36)
  reviewerId          String                  @db.VarChar(36)
  status              peer_assignment_status  @default(pending)
  performanceReviewId String?                 @db.VarChar(36)
  assignedAt          DateTime                @default(now()) @db.Timestamp(0)
  completedAt         DateTime?               @db.Timestamp(0)
  cycle               review_cycles           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewee            users                   @relation("PeerReviewee", fields: [revieweeId], references: [id])
  reviewer            users                   @relation("PeerReviewer", fields: [reviewerId], references: [id])
  performanceReview   performance_reviews?    @relation(fields: [performanceReviewId], references: [id])

  @@unique([cycleId, revieweeId, reviewerId])
  @@index([cycleId])
  @@index([revieweeId])
  @@index([reviewerId])
  @@index([status])
  @@map("peer_review_assignments")
}

model performance_reviews {
  id                       String                    @id @default(uuid()) @db.VarChar(36)
  reviewPeriod             String                    @db.VarChar(100)
  cycleId                  String?                   @db.VarChar(36)
  reviewType               performance_review_type   @default(self_review)
  employeeId               String                    @db.VarChar(36)
  managerId                String                    @db.VarChar(36)
  revieweeId               String?                   @db.VarChar(36)
  createdById              String?                   @db.VarChar(36)
  status                   performance_review_status @default(not_started)
  employeeCompletedAt      DateTime?
  managerReviewCompletedAt DateTime?
  discussionCompletedAt    DateTime?
  overallRating            Decimal?                  @db.Decimal(3, 2)
  promotionRecommended     Boolean                   @default(false)
  newJobLevel              String?                   @db.VarChar(50)
  finalSummary             String?                   @db.Text
  employeeAcknowledged     Boolean                   @default(false)
  createdAt                DateTime                  @default(now()) @db.Timestamp(0)
  updatedAt                DateTime                  @default(now()) @db.Timestamp(0)
  managerNotes             manager_feedback[]
  peerAssignments          peer_review_assignments[]
  creator                  users?                    @relation("ReviewCreator", fields: [createdById], references: [id])
  employee                 users                     @relation("EmployeeReviews", fields: [employeeId], references: [id])
  manager                  users                     @relation("ManagerReviews", fields: [managerId], references: [id])
  reviewee                 users?                    @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  cycle                    review_cycles?            @relation(fields: [cycleId], references: [id])
  responses                review_responses[]

  @@unique([employeeId, reviewPeriod, reviewType, revieweeId])
  @@index([employeeId])
  @@index([managerId])
  @@index([revieweeId])
  @@index([cycleId])
  @@index([status])
  @@index([reviewType])
  @@index([createdById], map: "performance_reviews_createdById_fkey")
  @@map("performance_reviews")
}

model review_questions {
  id           String               @id @default(uuid()) @db.VarChar(36)
  category     String               @db.VarChar(100)
  subcategory  String?              @db.VarChar(100)
  questionText String               @db.Text
  guidanceText String?              @db.Text
  questionType question_type
  phase        review_phase
  reviewType   question_review_type @default(self_review)
  targetRole   String?              @db.VarChar(50)
  weight       Decimal?             @db.Decimal(5, 2)
  displayOrder Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now()) @db.Timestamp(0)
  responses    review_responses[]

  @@index([phase])
  @@index([reviewType])
  @@index([isActive])
  @@map("review_questions")
}

model review_responses {
  id                  String                  @id @default(uuid()) @db.VarChar(36)
  performanceReviewId String                  @db.VarChar(36)
  questionId          String                  @db.VarChar(36)
  employeeId          String                  @db.VarChar(36)
  reviewerType        response_reviewer_type  @default(self)
  textResponse        String?                 @db.Text
  ratingResponse      Int?
  ratingDecimal       Decimal?                @db.Decimal(3, 2)
  nominationResponse  String?                 @db.Text
  overrideRating      Int?
  overrideNote        String?                 @db.Text
  createdAt           DateTime                @default(now()) @db.Timestamp(0)
  updatedAt           DateTime                @default(now()) @db.Timestamp(0)
  employee            users                   @relation(fields: [employeeId], references: [id])
  performanceReview   performance_reviews     @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  question            review_questions        @relation(fields: [questionId], references: [id])

  @@unique([performanceReviewId, questionId])
  @@index([performanceReviewId])
  @@index([questionId])
  @@index([employeeId])
  @@index([reviewerType])
  @@map("review_responses")
}

model manager_feedback {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  performanceReviewId String                @db.VarChar(36)
  managerId           String                @db.VarChar(36)
  feedbackType        manager_feedback_type
  originalResponse    String?               @db.Text
  managerComment      String?               @db.Text
  modifiedResponse    String?               @db.Text
  originalRating      Int?
  managerRating       Int?
  questionReference   String?               @db.VarChar(36)
  overrideNote        String?               @db.Text
  isVisible           Boolean               @default(true)
  createdAt           DateTime              @default(now()) @db.Timestamp(0)
  manager             users                 @relation(fields: [managerId], references: [id])
  performanceReview   performance_reviews   @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)

  @@index([performanceReviewId])
  @@index([managerId])
  @@index([feedbackType])
  @@map("manager_feedback")
}

enum leave_status {
  pending
  approved
  rejected
  cancelled
}

enum leave_requests_leave_length {
  full_day
  half_day
}

enum document_priority {
  low
  medium
  high
  urgent
}

enum document_assignment_status {
  pending
  viewed
  signed
  overdue
  completed
}

enum user_role_type {
  engineer
  product_manager
  manager
  admin
}

enum performance_review_status {
  not_started
  employee_in_progress
  employee_completed
  manager_reviewing
  discussion_scheduled
  discussion_completed
  final_review_complete
  acknowledged
  peer_review_pending
  peer_reviews_in_progress
  peer_reviews_complete
}

enum performance_review_type {
  self_review
  peer_review
  manager_appraisal
}

enum review_cycle_status {
  draft
  active
  closed
}

enum peer_assignment_status {
  pending
  in_progress
  completed
}

enum question_review_type {
  self_review
  peer_review
  manager_appraisal
  next_steps
}

enum response_reviewer_type {
  self
  peer
  manager
}

enum question_type {
  text
  rating
  nomination
}

enum review_phase {
  self
  peer
  nomination
}

enum manager_feedback_type {
  question_comment
  rating_adjustment
  general_feedback
  final_summary
  development_goals
}

enum notification_type {
  info
  success
  warning
  error
  reminder
  action_required
}

enum notification_category {
  leave_management
  document_management
  performance_reviews
  system_updates
  security
  general
}

enum notification_priority {
  low
  normal
  high
  urgent
}

enum documents_status {
  active
  archived
  deleted
  expire
}
