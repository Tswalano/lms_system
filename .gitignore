# =========================
# Global Git Ignore (Monorepo)
# =========================

# === Dependencies ===
node_modules/
**/node_modules/

# === Build Artifacts ===
dist/
build/
cdk.out/
coverage/
tmp/
temp/

# === CDK (Backend) ===
/backend/.env
/backend/cdk.out/
/backend/node_modules/
/backend/package-lock.json # optional if you want to ignore lockfile
/backend/.jsii
/backend/.tsbuildinfo

# === React + Vite (Frontend) ===
/frontend/dist/
/frontend/.env
/frontend/.env.*.local
/frontend/node_modules/
/frontend/package-lock.json # optional if you want to ignore lockfile

# === Environment and Local Configs ===
.env
.env.*
!.env.example

# === OS/Editor Junk ===
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.swp
*.swo
*.sublime-workspace

# === Misc ===
.pnp
.pnp.js
.vscode/
.idea/
